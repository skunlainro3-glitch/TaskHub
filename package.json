{
  "name": "taskhub-mvp",
  "version": "0.7.3",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:ui": "node tests/ui.mjs",
    "test:cloud": "node tests/cloud-api.mjs",
    "cloud:export": "node scripts/export-sites.mjs",
    "build:pages": "node scripts/build-pages.mjs",
    "data:backup": "node --env-file-if-exists=.env scripts/backup.mjs",
    "research:report": "node scripts/research-report.mjs",
    "survey:report": "node scripts/survey-report.mjs",
    "data:purge": "node --env-file-if-exists=.env scripts/purge.mjs"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "fflate": "0.8.3",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "read-excel-file": "9.3.12"
  },
  "devDependencies": {
    "playwright": "^1.64.0",
    "vite": "^7.1.0"
  }
}
